{
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ]
}
